{
  "name": "Frpc-Desktop",
  "version": "1.2.7",
  "description": "FRP跨平台桌面客户端，基于 Tauri 2 + Vue 3，可视化配置，轻量快速！",
  "repository": "github:luckjiawei/frpc-desktop",
  "author": "刘嘉伟 <8473136@qq.com>",
  "license": "MIT",
  "private": true,
  "keywords": [
    "frp",
    "frpc",
    "proxy",
    "tauri",
    "tauri-app",
    "vue",
    "vue3",
    "vite"
  ],
  "engines": {
    "node": ">= 22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "tauri": "node scripts/run-tauri.mjs",
    "tauri:dev": "node scripts/run-tauri.mjs dev",
    "tauri:build": "node scripts/run-tauri.mjs build",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .ts,.tsx,.vue",
    "lint:fix": "eslint src/ --ext .ts,.tsx,.vue --fix"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "@vueuse/core": "14.2.1",
    "animate.css": "^4.1.1",
    "canvas-confetti": "^1.9.4",
    "element-plus": "2.13.6",
    "intro.js": "^8.3.2",
    "js-base64": "^3.7.8",
    "lodash": "^4.18.1",
    "moment": "^2.29.4",
    "pinia": "3.0.4",
    "vue": "3.5.31",
    "vue-i18n": "11.3.0",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@iconify-icons/material-symbols": "^1.2.58",
    "@iconify/vue": "^5.0.0",
