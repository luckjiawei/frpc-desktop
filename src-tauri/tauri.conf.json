{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frpc-Desktop",
  "version": "1.2.7",
  "identifier": "com.luckjiawei.frpcdesktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3344",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Frpc-Desktop",
        "width": 1050,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
